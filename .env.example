# Copie para .env e preencha as chaves

# LLM Provider
GROQ_API_KEY=sua_chave_groq_aqui

# Telegram (opcional - use se for rodar bot_telegram.py)
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui

# WhatsApp/Evolution API (opcional - use se for rodar bot_whatsapp.py)
EVOLUTION_BASE_URL=https://evolution.seuservidor.com
EVOLUTION_INSTANCE=nome_da_instancia
EVOLUTION_API_KEY=api_key_da_instancia
EVOLUTION_WEBHOOK_PATH=/webhook/whatsapp
